# 复制为 .env 并填入你的配置（.env 已被 gitignore，不会提交）
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
DATA_DIR=data
ZHIPU_EMBEDDING_URL=https://open.bigmodel.cn/api/paas/v4/embeddings

# PostgreSQL（应用容器内使用 postgres 服务名；本地运行时可设为 localhost）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smart_regulation
POSTGRES_USER=regulation_app
POSTGRES_PASSWORD=

# Compose 中 MinIO 的访问账户；密码必须填写
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
WEB_PORT=8080

# 如虚拟机内 pip/npm 需要经过 Windows 宿主机代理，取消注释并按实际地址填写
# HTTP_PROXY=http://<proxy-host>:7897
# HTTPS_PROXY=http://<proxy-host>:7897

# Milvus 在子块查询中调用 SiliconFlow 重排模型
SILICONFLOW_API_KEY=

# Milvus 与应用参数
MILVUS_URI=http://localhost:19530
DB_NAME=default
COLLECTION_NAME=rag_collection
DIM=1024
MAX_UPLOAD_MB=20
# MinerU Open API Precision Token
MINERU_TOKEN=
